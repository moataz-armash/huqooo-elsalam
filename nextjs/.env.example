# Nothing needs to be set for the production domain to be correct --
# it is defined in app/site.js.
#
# Only set this to point the site at a different domain. It MUST match the
# host that actually serves a 200 (not one that redirects), and on Vercel it
# must be created with the "Config" type, not "Secret".
# NEXT_PUBLIC_SITE_URL=https://your-other-domain.com

# Strapi CMS that serves the blog. Without it the blog shows its
# "coming soon" state and the rest of the site is unaffected.
# No trailing slash. Server-side only, so it is not exposed to the browser.
# STRAPI_URL=https://api.hqolalsalam.com
