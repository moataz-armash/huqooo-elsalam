# Absolute URL of the live site, used for canonical links, Open Graph
# images, sitemap.xml and JSON-LD. No trailing slash.
#
# Leave this UNSET on Vercel: the production domain is derived from
# VERCEL_PROJECT_PRODUCTION_URL automatically. Only set it once a real
# custom domain is attached, and make sure the value actually resolves --
# a canonical pointing at a dead URL will deindex the site.
# NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
