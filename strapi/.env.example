# Copy to .env and fill in. The real .env lives only on the server and on your
# machine; it is gitignored, so a deploy never reads or overwrites it.

# --- Server ---
HOST=0.0.0.0
# 1337 is taken by api.divadentclinics.com on this box, so this app uses 1340.
PORT=1340
# Required behind nginx, or the admin panel builds wrong redirect URLs.
URL=https://api.hqolalsalam.com

# --- Secrets ---
# Generate each with: openssl rand -base64 32
# Changing API_TOKEN_SALT invalidates every existing API token, including the
# one Zapier uses. Changing ENCRYPTION_KEY makes stored encrypted values
# unreadable. Never regenerate these on an instance that is already in use.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database ---
# config/database.js accepts postgres, mysql or sqlite. Both the postgres and
# sqlite drivers are installed, so switching is an .env change plus a restart.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=huqool_cms
DATABASE_USERNAME=huqool_cms
DATABASE_PASSWORD=
DATABASE_SSL=false

# For sqlite instead, set DATABASE_CLIENT=sqlite and this path. Leaving it
# empty is not the same as omitting it: an empty value overrides the default
# and Strapi fails with "unable to open database file".
# DATABASE_FILENAME=.tmp/data.db

# --- Windows only ---
# See README section 6. Not needed on Linux.
# SWC_NATIVE_BINDING_CACHE=C:\swc-cache
