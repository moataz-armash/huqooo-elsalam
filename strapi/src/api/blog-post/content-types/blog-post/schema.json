{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 200,
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 500,
      "required": true
    },
    "content": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-category.blog-category",
      "inversedBy": "blog_posts"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "blog_posts"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "authorImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "scheduledDate": {
      "type": "datetime",
      "description": "Optional: Date and time when this post was scheduled to be published (for tracking Zapier/Airtable automation)"
    },
    "readingTime": {
      "type": "integer",
      "min": 1
    },
    "seoMetaTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 60
    },
    "seoMetaDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 160
    },
    "seoKeywords": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seoFocusKeyword": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seoCanonicalUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seoOgTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 60
    },
    "seoOgDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 160
    },
    "seoOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seoOgType": {
      "type": "enumeration",
      "enum": ["website", "article"],
      "default": "article"
    },
    "seoTwitterCard": {
      "type": "enumeration",
      "enum": ["summary", "summary_large_image"],
      "default": "summary_large_image"
    },
    "seoTwitterTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 70
    },
    "seoTwitterDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 200
    },
    "seoTwitterImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "seoSchemaMarkup": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seoRobotsMeta": {
      "type": "enumeration",
      "enum": [
        "index, follow",
        "index, nofollow",
        "noindex, follow",
        "noindex, nofollow"
      ],
      "default": "index, follow"
    },
    "seoNoIndex": {
      "type": "boolean",
      "default": false
    },
    "seoNoFollow": {
      "type": "boolean",
      "default": false
    },
    "related_posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-tag.blog-tag",
      "inversedBy": "blog_posts"
    }
  }
}
